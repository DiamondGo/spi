{
  "name": "spi",
  "version": "0.1.5",
  "description": "sPi - Simple Pi Agent GUI",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-vite build",
    "build:icons": "node scripts/icons.cjs",
    "test:icons": "node scripts/icons.test.cjs",
    "test:native-build": "node scripts/native-build.test.cjs && node scripts/macos-integrity.test.cjs",
    "start": "electron-vite preview",
    "dist": "node scripts/build-portable.cjs",
    "dist:linux": "node scripts/build-portable.cjs",
    "dist:win": "node scripts/build-portable.cjs",
    "dist:prepare": "node scripts/distribution.cjs prepare",
    "dist:manifest": "node scripts/distribution.cjs manifest",
    "dist:appimage": "electron-vite build && electron-builder --linux AppImage",
    "check:privacy": "node scripts/privacy.cjs",
    "test:installer": "node scripts/download.test.cjs && node scripts/installer.test.cjs",
    "test:distribution": "node scripts/with-display.cjs scripts/distribution.test.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:launch": "node scripts/launch.test.cjs && node scripts/pi-session.test.cjs",
    "test:sessions": "node scripts/sessions.test.cjs",
    "test:session-health": "node scripts/session-health.test.cjs",
    "test:workspace-actions": "node scripts/workspace-actions.test.cjs",
    "test:session-actions-smoke": "electron-vite build && node scripts/with-display.cjs scripts/smoke.cjs --session-actions",
    "test:session-health-smoke": "electron-vite build && node scripts/with-display.cjs scripts/smoke.cjs --session-health",
    "test:terminal": "node scripts/terminal.test.cjs",
    "test:terminal-smoke": "electron-vite build && node scripts/with-display.cjs scripts/smoke.cjs --terminal",
    "test:settings": "node scripts/settings.test.cjs",
    "test:settings-smoke": "electron-vite build && node scripts/with-display.cjs scripts/smoke.cjs --settings",
    "test:yolo": "node scripts/yolo.test.cjs && node scripts/session-bridge.test.cjs",
    "test:extension-ui": "node scripts/extension-ui.test.cjs",
    "test:workspace-ui": "node scripts/workspace-ui.test.cjs",
    "test:runtime-env-smoke": "electron-vite build && node scripts/with-display.cjs scripts/smoke.cjs --runtime-env",
    "test:workspace-ui-smoke": "electron-vite build && node scripts/with-display.cjs scripts/smoke.cjs --workspace-ui",
    "test:extension-ui-smoke": "electron-vite build && node scripts/with-display.cjs scripts/smoke.cjs --extension-ui",
    "test:yolo-smoke": "electron-vite build && node scripts/with-display.cjs scripts/smoke.cjs --yolo",
    "test:smoke": "electron-vite build && node scripts/with-display.cjs scripts/smoke.cjs",
    "test:advanced": "electron-vite build && node scripts/with-display.cjs scripts/smoke.cjs --advanced"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "^3.0.0",
    "esbuild": "^0.25.12",
    "tar": "^7.5.22",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
